export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Shell state must also be writable in Kandev's systemd mount namespace.
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export ZSH_CACHE_DIR="$XDG_CACHE_HOME/oh-my-zsh"
export ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump"
export HISTFILE="$XDG_STATE_HOME/zsh/history"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
mkdir -p "$ZSH_CACHE_DIR" "${ZSH_COMPDUMP:h}" "${HISTFILE:h}"
zstyle ':omz:update' mode disabled
fpath+=("$ZSH/custom/plugins/zsh-completions/src")

plugins=(
  git docker docker-compose z dirhistory history extract
  colored-man-pages command-not-found sudo safe-paste nvm
  zsh-autosuggestions pnpm-shell-completion netbird
)
[[ -t 0 && -t 1 ]] && plugins+=(fzf)
plugins+=(zsh-syntax-highlighting)

source "$ZSH/oh-my-zsh.sh"

export EDITOR="vim"
export VISUAL="$EDITOR"
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
export WORKSPACES={{ workspace_dir | quote }}

if [[ -r "$HOME/.config/agent-vm.env" ]]; then
  export STRIPE_API_KEY
  source "$HOME/.config/agent-vm.env"
fi

# Honor repository packageManager pins instead of an old NVM-global pnpm.
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

alias g='git'
alias gst='git status --short --branch'
alias gl='git pull --ff-only'
alias gp='git push'

function croot() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return
  cd "$root"
}

function mkworktree() {
  [[ $# -eq 2 ]] || { echo "usage: mkworktree <branch> <path>" >&2; return 2; }
  git worktree add -b "$1" "$2"
}
