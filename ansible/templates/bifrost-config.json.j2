{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "enforce_auth_on_inference": true
  },
  "providers": {
    "cliproxy": {
      "keys": [
        {
          "name": "cliproxy-internal",
          "value": "env.CLIPROXY_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:{{ ports.cliproxyapi }}"
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "text_completion": true,
          "text_completion_stream": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true
        },
        "request_path_overrides": {
          "list_models": "/v1/models",
          "text_completion": "/v1/completions",
          "text_completion_stream": "/v1/completions",
          "chat_completion": "/v1/chat/completions",
          "chat_completion_stream": "/v1/chat/completions",
          "responses": "/v1/responses",
          "responses_stream": "/v1/responses"
        }
      }
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": true
    },
    "virtual_keys": [
      {
        "id": "vk-agent-vm",
        "name": "agent-vm-tools",
        "value": "env.BIFROST_VIRTUAL_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "cliproxy",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
{% if pr_agent is not none %}
      },
      {
        "id": "vk-pr-agent",
        "name": "pr-agent",
        "value": "env.PR_AGENT_BIFROST_VIRTUAL_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "cliproxy",
            "allowed_models": [{{ pr_agent.bifrost_model | to_json }}, {{ pr_agent.bifrost_fallback_model | to_json }}],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
{% endif %}
      }
    ]
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {"path": "./config.db"}
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {"path": "./logs.db"}
  }
}
