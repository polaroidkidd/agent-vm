#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import tempfile
from pathlib import Path
from urllib.request import Request, urlopen


def read_environment(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        values[name.strip()] = value.strip().strip('"').strip("'")
    return values


def fetch_catalog(base_url: str, api_key: str) -> dict:
    request = Request(
        f"{base_url.rstrip('/')}/v1/models",
        headers={"Authorization": f"Bearer {api_key}"},
    )
    with urlopen(request, timeout=30) as response:
        return json.load(response)


def catalog_ids(catalog: dict) -> list[str]:
    entries = catalog.get("data") if isinstance(catalog, dict) else None
    if not isinstance(entries, list):
        raise ValueError("Bifrost returned an invalid model catalog")
    ids = sorted({entry.get("id") for entry in entries if isinstance(entry, dict) and isinstance(entry.get("id"), str)})
    if not ids:
        raise ValueError("Bifrost returned an empty model catalog; complete CLIProxyAPI OAuth first")
    return ids


def choose_default(model_ids: list[str], preferred: str) -> str:
    for model_id in model_ids:
        if model_id == preferred or model_id.endswith(f"/{preferred}"):
            return model_id
    usable = [model_id for model_id in model_ids if "auto-review" not in model_id]
    for model_id in usable:
        if model_id.endswith("-sol"):
            return model_id
    return (usable or model_ids)[0]


def model_entry(model_id: str) -> dict:
    display_name = model_id.removeprefix("cliproxy/")
    return {
        "id": model_id,
        "name": f"{display_name} through Bifrost and CLIProxyAPI",
        "reasoning": True,
        "input": ["text", "image"],
        "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
    }


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(value, output, indent=2)
            output.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def update_pi_files(catalog: dict, models_path: Path, settings_path: Path, preferred: str) -> tuple[list[str], str]:
    model_ids = catalog_ids(catalog)
    models_config = json.loads(models_path.read_text(encoding="utf-8"))
    provider = models_config.get("providers", {}).get("bifrost")
    if not isinstance(provider, dict):
        raise ValueError(f"{models_path} does not define the Bifrost provider")
    provider["models"] = [model_entry(model_id) for model_id in model_ids]

    settings = json.loads(settings_path.read_text(encoding="utf-8"))
    default_model = choose_default(model_ids, preferred)
    settings["defaultProvider"] = "bifrost"
    settings["defaultModel"] = default_model

    write_json(models_path, models_config)
    write_json(settings_path, settings)
    return model_ids, default_model


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Synchronize Pi models from the live Bifrost catalog")
    result.add_argument("--base-url", required=True)
    result.add_argument("--environment-path", type=Path, required=True)
    result.add_argument("--models-path", type=Path, required=True)
    result.add_argument("--settings-path", type=Path, required=True)
    result.add_argument("--preferred", required=True)
    return result


def main() -> int:
    args = parser().parse_args()
    environment = read_environment(args.environment_path)
    api_key = environment.get("BIFROST_VIRTUAL_KEY")
    if not api_key:
        raise ValueError(f"BIFROST_VIRTUAL_KEY is missing from {args.environment_path}")
    catalog = fetch_catalog(args.base_url, api_key)
    model_ids, default_model = update_pi_files(
        catalog,
        args.models_path,
        args.settings_path,
        args.preferred,
    )
    print(f"Synchronized {len(model_ids)} Pi model(s); default is {default_model}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
